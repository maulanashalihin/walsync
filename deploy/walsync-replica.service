# walsync replica — receives WAL from primary
# Usage:
#   1. Copy walsync binary to /usr/local/bin/walsync
#   2. Copy this file to /etc/systemd/system/walsync-replica.service
#   3. Edit -db path and -listen port below
#   4. systemctl daemon-reload
#   5. systemctl enable --now walsync-replica

[Unit]
Description=walsync replica (SQLite WAL receiver)
After=network.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/walsync \
  -mode replica \
  -db /var/lib/walsync/app.db \
  -listen :9090
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/walsync

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=walsync-replica

[Install]
WantedBy=multi-user.target
